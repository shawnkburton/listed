# Enable only after the corresponding provider is configured in Firebase.
# Public flags only: never put provider secrets in NEXT_PUBLIC variables.
NEXT_PUBLIC_APPLE_AUTH_ENABLED=false
NEXT_PUBLIC_FACEBOOK_AUTH_ENABLED=false

# Optional server-only durable SQLite path (Node 24+). Never put this under public/.
# LISTED_DATABASE_PATH=/absolute/private/path/marketplace.sqlite

# Optional private video storage directory; never use public/.
# LISTED_VIDEO_DIRECTORY=/absolute/private/path/videos

# Only for a trusted reverse proxy that terminates HTTPS on the public site.
# LISTED_PUBLIC_ORIGIN=https://your-listed-domain.example

# Optional browser key restricted to the Maps JavaScript API and your Listed website.
# Supply at build time to enable Google 3D Flyover and Street View Drive-by.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
